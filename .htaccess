# Hand the container's LLM settings to PHP: Apache doesn't pass its own
# environment on to PHP by itself (modules/llm and modules/laya read these;
# config/site_owner.php the owner's name and email for the privacy page).
<IfModule mod_env.c>
    PassEnv OPENAI_API_KEY ANTHROPIC_API_KEY LLM_API_KEY LLM_PROVIDER LLM_MODEL LLM_KEY_SECRET LAYA_URL LAYA_API_KEY APP_ENV OUR_NAME OUR_EMAIL_ADDRESS
</IfModule>

<IfModule mod_headers.c>
    Header set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine on
  RewriteRule ^$ public/ [L]
  RewriteRule (.*) public/$1 [L]
</IfModule>